    {
      "case_id": "exception-and-escalation-remain-separate",
      "purpose": "Keep an exception and escalation condition explicit without promoting either into the normal resolution path.",
      "scope": "component",
      "approval": "approved",
      "origin": "synthetic",
      "tags": ["exception", "escalation", "troubleshooting"],
      "inputs": {
        "article_type": "troubleshooting",
        "subject": "Device registration recovery",
        "evidence": [
          {
            "chunk_id": "ka-exception-1",
            "text": "For a standard stale-registration failure, clear the stale entry and reconnect the device."
          },
          {
            "chunk_id": "ka-exception-2",
            "text": "If the device certificate is revoked, do not reconnect the device."
          },
          {
            "chunk_id": "ka-exception-3",
            "text": "Escalate to the security operations queue when a revoked certificate is confirmed."
