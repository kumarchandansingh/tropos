  "notes": "Approved synthetic golden cases for deterministic Knowledge Article regression before live-model comparison.",
  "cases": [
    {
      "case_id": "normal-how-to-device-reconnect",
      "purpose": "Validate a straightforward grounded how-to article with no invented gaps or actions.",
      "scope": "component",
      "approval": "approved",
      "origin": "synthetic",
      "tags": ["normal", "how_to", "grounding"],
      "inputs": {
        "article_type": "how_to",
        "subject": "Reconnect a device after stale registration",
        "evidence": [
          {
            "chunk_id": "ka-normal-1",
            "text": "Clear the stale registration entry before attempting to reconnect the device."
          },
          {
            "chunk_id": "ka-normal-2",
            "text": "Reconnect the device. A successful reconnection changes the status to Connected."
          }
        ]
      },
      "expected": {
        "article_type": "how_to",
        "required_sections": ["purpose", "steps", "expected_result"],
        "claims": [
          {
            "contains": "clear",
            "evidence_chunk_ids": ["ka-normal-1"]
          },
          {
            "contains": "reconnect",
            "evidence_chunk_ids": ["ka-normal-2"]
          },
          {
            "contains": "connected",
            "evidence_chunk_ids": ["ka-normal-2"]
          }
        ],
        "gaps": [],
        "forbidden_terms": ["factory reset", "delete account"]
      }
    },
    {
      "case_id": "missing-information-becomes-gap",
      "purpose": "Require missing escalation details to remain an explicit gap instead of being invented.",
      "scope": "component",
      "approval": "approved",
      "origin": "synthetic",
      "tags": ["missing_information", "troubleshooting", "grounding"],
      "inputs": {
        "article_type": "troubleshooting",
        "subject": "Device remains disconnected",
        "evidence": [
          {
            "chunk_id": "ka-missing-1",
            "text": "If the device remains disconnected, clear stale registration and retry the connection."
          },
          {
            "chunk_id": "ka-missing-2",
            "text": "The support note does not specify when the issue should be escalated."
          }
        ]
      },
      "expected": {
        "article_type": "troubleshooting",
        "required_sections": [
          "issue_description",
          "symptoms",
          "resolution_steps",
          "expected_result",
          "gaps"
        ],
        "claims": [
          {
            "contains": "disconnected",
            "evidence_chunk_ids": ["ka-missing-1"]
          },
          {
            "contains": "clear stale registration",
            "evidence_chunk_ids": ["ka-missing-1"]
          }
        ],
        "gaps": [
          {
            "contains": "escalat",
            "kind": "missing_information",
            "evidence_chunk_ids": ["ka-missing-2"]
          }
        ],
        "forbidden_terms": ["escalate after 30 minutes", "severity 1"]
      }
    },
    {
      "case_id": "conflicting-evidence-becomes-gap",
      "purpose": "Require contradictory source instructions to be surfaced as a conflict rather than selecting one silently.",
      "scope": "component",
