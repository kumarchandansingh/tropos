        ],
        "claims": [
          {
            "contains": "clear the stale",
            "evidence_chunk_ids": ["ka-exception-1"]
          },
          {
            "contains": "do not reconnect",
            "evidence_chunk_ids": ["ka-exception-2"]
          },
          {
            "contains": "security operations",
            "evidence_chunk_ids": ["ka-exception-3"]
          }
        ],
        "gaps": [],
        "forbidden_terms": ["reconnect revoked certificate"]
