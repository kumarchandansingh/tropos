      "inputs": {
        "article_type": "troubleshooting",
        "subject": "Retry policy for failed registration",
        "evidence": [
          {
            "chunk_id": "ka-conflict-1",
            "text": "Retry registration once after clearing the stale registration entry."
          },
          {
            "chunk_id": "ka-conflict-2",
            "text": "Do not retry registration after a failed attempt; escalate the case immediately."
          }
        ]
      },
      "expected": {
        "article_type": "troubleshooting",
        "required_sections": [
          "issue_description",
          "symptoms",
          "resolution_steps",
          "expected_result",
          "gaps"
        ],
        "claims": [],
        "gaps": [
          {
            "contains": "conflict",
            "kind": "conflict",
            "evidence_chunk_ids": ["ka-conflict-1", "ka-conflict-2"]
