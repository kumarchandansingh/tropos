  "cards": [
    {
      "dot": "emerald",
      "title": "Canonical content identity",
      "items": [
        "Source payload integrity and content identity are separate",
        "Normalization happens before version resolution",
        "Only CREATE_VERSION materializes and chunks a new document"
      ]
    },
    {
      "dot": "amber",
      "title": "Access changes are separate",
      "items": [
        "An access-policy change can trigger refresh without new content",
        "Governance refresh can also precede creating a new version",
        "Unchanged content and changed normalization strategy do not automatically create versions"
      ]
    },
    {
      "dot": "slate",
      "title": "Orchestration and replay",
      "items": [
        "Repeated completed captures return the prior result",
        "Ingestion stages, outcomes and failures are recorded separately",
        "NO_CONTENT_VERSION and REBASELINE_REQUIRED do not write new chunks"
      ]
    }
  ]
