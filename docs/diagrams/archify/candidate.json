  "cards": [
    {
      "dot": "emerald",
      "title": "Why canonical identity matters",
      "items": [
        "Raw payload fingerprint: tracks exact captured bytes. Canonical fingerprint: tracks normalized knowledge content.",
        "Normalization removes specified presentation noise such as line-ending and whitespace differences.",
        "Meaning-bearing content changes create a new canonical identity; harmless formatting changes need not."
      ]
    },
    {
      "dot": "violet",
      "title": "Version resolution: four possible outcomes",
      "items": [
        "CREATE_VERSION: first content or a changed canonical fingerprint; materialize the document and deterministic chunks.",
        "NO_CONTENT_VERSION: identical canonical content and access; preserve the existing version.",
        "REFRESH_GOVERNANCE: same content but changed access; update permissions without new chunks.",
        "REBASELINE_REQUIRED: normalization strategy changed; pause automatic content versioning for explicit rebaseline."
      ]
    },
    {
      "dot": "amber",
      "title": "The independent governance path",
      "items": [
        "Content fingerprints and access-policy fingerprints are evaluated separately.",
        "If access changes alongside content, refresh governance on existing persisted evidence before later version work.",
        "Access-only changes must not masquerade as a content revision."
      ]
    },
    {
      "dot": "slate",
      "title": "Provenance, replay, and durability",
      "items": [
        "Immutable source capture preserves source identity, source version, exact bytes and access context.",
        "A completed capture with the same ingestion fingerprint returns its prior result (idempotent replay).",
        "SQLite retains ingestion runs, current canonical state, document versions, chunks and failure outcomes."
      ]
    }
  ]
