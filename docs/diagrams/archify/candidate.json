  "cards": [
    {
      "dot": "cyan",
      "title": "1 · Governed knowledge before AI",
      "items": [
        "Source acquisition, parsing, normalization, content versioning, governance refresh and chunking remain deterministic concerns.",
        "SQLite is the current durable local/test baseline; production Postgres remains planned."
      ]
    },
    {
      "dot": "violet",
      "title": "2 · Retrieval strategies stay separable",
      "items": [
        "BM25 preserves exact-term behavior; dense retrieval uses exact cosine before ANN complexity.",
        "Hybrid V1 uses Reciprocal Rank Fusion because BM25 and cosine scores are not directly comparable."
      ]
    },
    {
      "dot": "emerald",
      "title": "3 · Stable evidence outside the model",
      "items": [
        "Generated artifacts persist stable EvidenceRef objects; temporary E1..EN aliases exist only inside a model invocation.",
        "Alias validity proves reference identity, not semantic entailment."
      ]
    },
    {
      "dot": "amber",
      "title": "4 · Capability-owned semantics",
      "items": [
        "Resolve owns Knowledge Article/service-resolution semantics; Training owns procedure-generation semantics.",
        "LangChain is an adapter for structured model execution, not the owner of evidence, authorization or lifecycle."
      ]
    },
    {
      "dot": "rose",
      "title": "5 · Quality and deferred complexity",
      "items": [
        "Software CI, retrieval evaluation and grounded-generation evaluation are separate evidence layers.",
        "ANN/HNSW, LangGraph-style durable orchestration and hosted observability remain deferred until measured needs justify them."
      ]
    }
  ]
