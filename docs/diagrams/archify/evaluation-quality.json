  "cards": [
    {
      "dot": "cyan",
      "title": "1 · Start from product behavior",
      "items": [
        "Ask what the product is trying to do and what output exists at that boundary before selecting an evaluation method.",
        "The same word 'eval' must not hide whether we are testing code correctness, a system invariant, retrieval quality, model output or a user outcome."
      ]
    },
    {
      "dot": "rose",
      "title": "2 · Invariants are not quality scores",
      "items": [
        "Authorization, currentness and evidence integrity are zero-tolerance properties.",
        "A security/integrity defect remains a blocker even when Recall or another benchmark metric improves."
      ]
    },
    {
      "dot": "emerald",
      "title": "3 · Model eval means a model produced the output",
      "items": [
        "A deterministic Knowledge Article grader can be unit-tested with hand-authored drafts.",
        "It becomes a model eval only when the real generator produces the draft being graded; stochastic subjects may require repeated trials."
      ]
    },
    {
      "dot": "amber",
      "title": "4 · Future product evaluation is a different layer",
      "items": [
        "Acceptance, edits, resolution success and time-to-resolution measure workflow outcomes rather than component quality.",
        "That product-outcome signal is not implemented in Tropos today."
      ]
    }
  ]
