# Tropos local runtime configuration
# Copy to .env locally if your launcher loads dotenv files.
# Never commit a real .env file; .gitignore excludes it.

TROPOS_LLM_PROVIDER=groq
TROPOS_LLM_MODEL=openai/gpt-oss-120b

# Secret: generate this in the Groq console and set it only in your local/runtime environment.
TROPOS_GROQ_API_KEY=


# Optional semantic retrieval runtime.
# BM25 remains available without these settings.
TROPOS_EMBEDDING_PROVIDER=openai
TROPOS_EMBEDDING_MODEL=text-embedding-3-small
TROPOS_EMBEDDING_DIMENSIONS=1536

# Secret: required only for dense_exact / hybrid_rrf and embedding materialization.
TROPOS_OPENAI_API_KEY=
