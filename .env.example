# Tropos local runtime configuration
# Copy to .env locally if your launcher loads dotenv files.
# Never commit a real .env file; .gitignore excludes it.

TROPOS_LLM_PROVIDER=groq
TROPOS_LLM_MODEL=openai/gpt-oss-120b

# Secret: generate this in the Groq console and set it only in your local/runtime environment.
TROPOS_GROQ_API_KEY=
